   "metadata": {},
   "outputs": [],
   "source": [
    "def parse_fact(text):\n",
    "    text = text.strip()\n",
    "\n",
    "    if \"=\" in text:\n",
    "        variable, value = text.split(\"=\")\n",
    "        return (variable.strip(), value.strip())\n",
    "\n",
    "    return (text.strip(), True)\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "1969d282",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_fact_value(facts, variable):\n",
    "    for fact in facts:\n",
    "        if fact[0] == variable:\n",
    "            return fact[1]\n",
    "\n",
    "    return None\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "f058707a",
   "metadata": {},
   "outputs": [],
   "source": [
    "def condition_is_true(condition, facts):\n",
    "    if len(condition) == 2:\n",
    "        return condition in facts\n",
    "\n",
    "    variable, operator, value = condition\n",
    "    fact_value = get_fact_value(facts, variable)\n",
    "\n",
    "    if fact_value is None:\n",
    "        return False\n",
    "\n",
    "    fact_value = float(fact_value)\n",
    "    value = float(value)\n",
    "\n",
    "    if operator == \">\":\n",
    "        return fact_value > value\n",
    "\n",
    "    if operator == \"<\":\n",
    "        return fact_value < value\n",
    "\n",
    "    return False\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "04bcc3d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def rule_is_true(conditions, connector, facts):\n",
    "    results = []\n",
    "\n",
    "    for condition in conditions:\n",
    "        results.append(condition_is_true(condition, facts))\n",
    "\n",
    "    if connector == \"%\":\n",
    "        return all(results)\n",
    "\n",
    "    if connector == \"|\":\n",
    "        return any(results)\n",
    "\n",
    "    return results[0]"
   ]
  },
