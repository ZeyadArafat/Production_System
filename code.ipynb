  "print(\"\\n===========================================================\")\n",
  "print(\"===========================================================\")\n",
  "print(\"\\n Backward Chaining\")\n",
  "def backward_chaining_cycle(goal, processed_facts, processed_rules):\n",
  " known_facts = processed_facts.copy()\n",
  " goals = [goal]\n",
  " cycle = 1\n",
  "\n",
  " while len(goals) > 0:\n",
  "  print(\"\\nCycle\", cycle)\n",
  "  print(\"Known facts:\", known_facts)\n",
  "  print(\"Current goals:\", goals)\n",
  "\n",
  "  new_goals = []\n",
  "  progress = False\n",
  "\n",
  "  for current_goal in goals:\n",
  "   if current_goal in known_facts:\n",
  "    print(\"Already known:\", current_goal)\n",
  "    continue\n",
  "\n",
  "   found_rule = False\n",
  "\n",
  "   for conditions, conclusion, connector in processed_rules:\n",
  "    conclusion_fact = parse_fact(conclusion)\n",
  "\n",
  "    if conclusion_fact == current_goal:\n",
  "     print(\"Using rule:\", conditions, \"=>\", current_goal)\n",
  "     found_rule = True\n",
  "\n",
  "     sub_results = []\n",
  "\n",
  "     for condition in conditions:\n",
  "      if len(condition) == 3:\n",
  "       variable, operator, value = condition\n",
  "       fact_value = get_fact_value(known_facts, variable)\n",
  "\n",
  "       if fact_value is None:\n",
  "        sub_results.append(False)\n",
  "        continue\n",
  "\n",
  "       fact_value = float(fact_value)\n",
  "       value = float(value)\n",
  "\n",
  "       if operator == \">\":\n",
  "        sub_results.append(fact_value > value)\n",
  "       elif operator == \"<\":\n",
  "        sub_results.append(fact_value < value)\n",
  "       else:\n",
  "        sub_results.append(False)\n",
  "\n",
  "      else:\n",
  "       if condition not in known_facts:\n",
  "        new_goals.append(condition)\n",
  "       sub_results.append(condition in known_facts)\n",
  "\n",
  "     #AND\n",
  "     if connector == \"%\":\n",
  "      if all(sub_results):\n",
  "       print(\"Inferred:\", current_goal)\n",
  "       known_facts.append(current_goal)\n",
  "       progress = True\n",
  "\n",
  "     #OR\n",
  "     elif connector == \"|\":\n",
  "      if any(sub_results):\n",
  "       print(\"Inferred:\", current_goal)\n",
  "       known_facts.append(current_goal)\n",
  "       progress = True\n",
  "\n",
  "     else:\n",
  "      if sub_results[0]:\n",
  "       print(\"Inferred:\", current_goal)\n",
  "       known_facts.append(current_goal)\n",
  "       progress = True\n",
  "\n",
  "   if not found_rule:\n",
  "    print(\"No rule found for:\", current_goal)\n",
  "\n",
  "  if not progress and len(new_goals) == 0:\n",
  "   print(\"No progress possible. Backward chaining stopped.\")\n",
  "   break\n",
  "\n",
  "  goals = new_goals\n",
  "  cycle += 1\n",
  "\n",
  " if goal not in known_facts:\n",
  "  for conditions, conclusion, connector in processed_rules:\n",
  "   if parse_fact(conclusion) == goal:\n",
  "    if rule_is_true(conditions, connector, known_facts):\n",
  "     print(\"Final inferred goal:\", goal)\n",
  "     known_facts.append(goal)\n",
  "\n",
  " return known_facts\n",
  "\n",
  "\n",
  "goal = ('fruit', 'orange')\n",
  "\n",
  "result = backward_chaining_cycle(goal, processed_facts, processed_rules)\n",
  "\n",
  "print(\"\\nFinal Facts:\", result)\n",
  "\n",
  "if goal in result:\n",
  "    print(\"\\nBackward chaining result: Goal PROVED \")\n",
  "else:\n",
  "    print(\"\\nBackward chaining result: Goal NOT proved \")\n"
