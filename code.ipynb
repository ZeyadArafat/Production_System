    "def forward_chaining(processed_facts, processed_rules):\n",
    "    known_facts = processed_facts.copy()\n",
    "    cycle = 1\n",
    "\n",
    "    while True:\n",
    "        print(\"\\nCycle\", cycle)\n",
    "        print(\"Facts at start of cycle:\")\n",
    "        print(known_facts)\n",
    "\n",
    "        new_facts = []\n",
    "\n",
    "        for conditions, conclusion, connector in processed_rules:\n",
    "            conclusion_fact = parse_fact(conclusion)\n",
    "\n",
    "            if rule_is_true(conditions, connector, known_facts):\n",
    "                if conclusion_fact not in known_facts and conclusion_fact not in new_facts:\n",
    "                    new_facts.append(conclusion_fact)\n",
    "                    print(\"New inferred fact:\", conclusion_fact)\n",
    "\n",
    "        if len(new_facts) == 0:\n",
    "            print(\"No new facts inferred. Forward chaining stopped.\")\n",
    "            break\n",
    "\n",
    "        known_facts.extend(new_facts)\n",
    "\n",
    "        print(\"Facts at end of cycle:\")\n",
    "        print(known_facts)\n",
    "\n",
    "        cycle += 1\n",
    "\n",
    "    return known_facts\n",
    "\n",
    "\n",
    "final_facts = forward_chaining(processed_facts, processed_rules)\n",
    "\n",
    "print(\"\\nFinal Facts:\")\n",
    "print(final_facts)"
   ]
  }
