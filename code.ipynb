   "source": [
    "with open(\"facts.txt\", \"r\") as f:\n",
    "    raw_facts = [line.strip() for line in f.readlines()]\n",
    "with open(\"rules.txt\", \"r\") as f:\n",
    "    raw_rules = [line.strip() for line in f.readlines()]"
   ]
