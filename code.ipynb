     ]
    }
   ],
   "source": [
    "rules = []\n",
    "facts = []\n",
    "for rule in raw_rules:\n",
    "    rule = rule.replace(\"IF\", \"\")\n",
    "    rule = rule.replace(\"is\", \"=\")\n",
    "    rule = rule.replace(\"AND\", \"&\")\n",
    "    rule = rule.replace(\"OR\", \"|\")\n",
    "    rules.append(rule.split(\"THEN\"))\n",
    "for fact in raw_facts:\n",
    "    fact = fact.replace(\"is\", \"=\")\n",
    "    facts.append(fact)\n",
    "print(rules)\n",
    "print(facts)"
   ]
  },
