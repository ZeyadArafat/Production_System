   "source": [
    "processed_rules = []\n",
    "for rule in rules:\n",
    "    conditions = rule[0]\n",
    "    conclusion = rule[1]\n",
    "    if \"&\" in conditions:\n",
    "        conditions = conditions.split(\"&\")\n",
    "        connector = \"%\"\n",
    "        conditions = [condition.strip() for condition in conditions]\n",
    "    elif \"|\" in conditions:\n",
    "        conditions = conditions.split(\"|\")\n",
    "        connector = \"|\"\n",
    "        conditions = [condition.strip() for condition in conditions]\n",
    "    else:\n",
    "        conditions = [conditions.strip()]\n",
    "        connector = \"_\"\n",
    "    processed_conditions = []\n",
    "    for condition in conditions:\n",
    "        if len(condition.split(\"=\")) == 2:\n",
    "            variable = condition.split(\"=\")[0].strip()\n",
    "            value = condition.split(\"=\")[1].strip()\n",
    "            condition = (variable, value)\n",
    "        elif len(condition.split(\">\")) == 2:\n",
    "            variable = condition.split(\">\")[0].strip()\n",
    "            value = condition.split(\">\")[1].strip()\n",
    "            condition = (variable, \">\", value)\n",
    "        elif len(condition.split(\"<\")) == 2:\n",
    "            variable = condition.split(\"<\")[0].strip()\n",
    "            value = condition.split(\"<\")[1].strip()\n",
    "            condition = (variable, \"<\", value)\n",
    "        else:\n",
    "            variable = condition.strip()\n",
    "            condition = (variable, True)\n",
    "        processed_conditions.append(condition)\n",
    "    processed_rules.append((processed_conditions, conclusion, connector))\n",
    "processed_rules"
   ]
